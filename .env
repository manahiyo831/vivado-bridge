# vivado-bridge configuration
# Read by both the TCL server and the Python clients. The defaults below
# work as-is for a single Vivado on the same machine; edit only if you
# need a different port (e.g. running a second Vivado in parallel) or
# want to listen on a non-loopback address.

# --- Bridge server ----------------------------------------------------------

# Address to bind the TCL server on. Use 127.0.0.1 for local-only access
# (recommended). Use 0.0.0.0 only if you really need remote access — there
# is NO authentication, so anyone reachable can run arbitrary TCL.
VIVADO_BRIDGE_HOST=127.0.0.1

# Port to listen on. Pick any unused port. Avoid common ones (8080, 9999,
# 12345, etc.) to reduce the chance of collision with other tools.
# Suggested: 53729
VIVADO_BRIDGE_PORT=53729

# --- Optional: launch scripts ----------------------------------------------
# Only used if you run the (deprecated) launch_vivado helper scripts.
# If you start Vivado manually, you can ignore this.

# Path to the Vivado executable.
# Windows example:
# VIVADO_PATH=C:\Xilinx\Vivado\2024.1\bin\vivado.bat
# Linux example:
# VIVADO_PATH=/tools/Xilinx/Vivado/2024.1/bin/vivado
